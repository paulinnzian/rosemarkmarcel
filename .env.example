# Copier en .env.local et remplir. En local : valeurs affichées par « pnpm exec supabase start ».
# En production : Supabase > Project Settings > API, puis les mêmes noms dans Vercel.

# URL du projet Supabase (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (anon / publishable) : lecture du contenu public, connexion admin. RLS protège les écritures.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service (secret) : serveur uniquement (scripts/add-admin.ts, /api/evenements). Jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Adresse publique du site, sans barre finale (liens des e-mails de connexion)
NEXT_PUBLIC_SITE_URL=
# Secret de la vérification quotidienne des liens (/api/liens/verifier, vercel.json). Vercel l'envoie dans
# l'en-tête Authorization. Une longue valeur aléatoire (openssl rand -hex 32). Absent : la tâche est désactivée.
CRON_SECRET=
