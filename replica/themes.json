{
  "_about": "Thèmes de la catégorie « page lien en bio / vitrine de créateur » (proxy de l'original, qui n'a aucun avis public). Copie adaptée du themes.json de replica-entrepreneur : thèmes génériques gardés, thèmes de la catégorie ajoutés, motifs anglais et français.",
  "request_patterns": [
    "\\bi wish\\b", "\\bplease add\\b", "\\bwould be (nice|great|good|helpful)\\b", "\\bwould love\\b",
    "\\bneeds? (a|an|the|to|more)\\b", "\\bno way to\\b", "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
    "\\b(missing|lacks|lacking)\\b", "\\bdoesn'?t (have|support|let|allow)\\b", "\\bif only\\b", "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
    "\\bmettez\\b", "\\bimpossible de\\b", "\\bdommage qu\\b", "\\bje ne peux pas\\b"
  ],
  "themes": [
    {"id": "upsell", "label": "Pression pour passer à l'offre payante", "kind": "complaint",
     "patterns": ["\\bupsell", "\\bupgrade (to|in order)\\b", "\\bpro (plan|version|features|model|subscriber|package)\\b", "\\bpaywall", "\\bfree version\\b", "\\bpredatory\\b", "trying to (sell you|get you to)", "\\bpaid functions\\b", "\\bshould be free\\b", "\\bnot free\\b", "\\bpop-?ups?\\b"]},
    {"id": "fees", "label": "Commissions et frais sur les revenus du créateur", "kind": "complaint",
     "patterns": ["\\b(take|takes|taking) (a )?cuts?\\b", "\\bcuts from\\b", "\\bcommission", "\\bhigh fees\\b", "\\bpart of their earnings\\b", "\\bpayouts?\\b", "\\bget paid\\b", "\\bmy money\\b", "\\bmissing funds\\b"]},
    {"id": "pricing", "label": "Prix trop élevé ou en hausse", "kind": "complaint",
     "patterns": ["\\bexpensive\\b", "\\boverpriced\\b", "\\bprice gouging\\b", "\\bprix\\b", "\\$\\s?\\d+", "\\d+\\s?€", "\\bmonthly fee\\b", "\\bsubscription\\b", "\\bnot worth\\b"]},
    {"id": "billing", "label": "Résiliation, prélèvements, remboursements", "kind": "complaint",
     "patterns": ["\\bcharg(ed|es|ing)\\b", "\\brefund", "\\bcancel", "\\bunsubscribe\\b", "\\brenew", "\\bfraud\\b", "\\bscam\\b", "\\bcredit card\\b", "\\bmoney back\\b"]},
    {"id": "trust", "label": "Conditions d'utilisation, IA et droits sur le contenu", "kind": "complaint",
     "patterns": ["\\bterms of service\\b", "\\btos\\b", "\\bown the rights\\b", "\\bgenerative ai\\b", "\\bdall-?e\\b", "\\bai (update|options|platform|bs)\\b", "\\bmore ai\\b", "\\bneeded ai\\b", "\\bslopware\\b", "\\btaking my data\\b", "\\bsteals? your data\\b"]},
    {"id": "moderation", "label": "Comptes bannis ou contenus retirés", "kind": "complaint",
     "patterns": ["\\bbann?ed\\b", "\\bunbanned\\b", "\\bmoderat", "\\bthey will delete it\\b", "\\bsuspend", "\\baccount taken\\b"]},
    {"id": "lockin", "label": "Enfermement, fermeture du service", "kind": "complaint",
     "patterns": ["\\blocks? you in\\b", "\\bno exit\\b", "\\bcan'?t get out\\b", "\\bfolded\\b", "\\bshutting down\\b", "\\blet me delete my account\\b", "\\bdépendant\\b"]},
    {"id": "visitor-breakage", "label": "La page ou les liens ne marchent pas pour les visiteurs", "kind": "complaint",
     "patterns": ["\\blinks? (often )?(don'?t|doesn'?t|not) work", "\\bwasn'?t working\\b", "\\bdoesn'?t load\\b", "\\blose business\\b", "\\bwebsite (is )?down\\b", "\\bserver (always )?(get )?down\\b", "\\bnot (open|load)(ing)? the pages\\b", "\\bcan'?t load my links\\b", "\\bnavigation to links\\b", "\\bnot getting (they|their) (emails|ebooks)\\b"]},
    {"id": "accessibility", "label": "Inutilisable au lecteur d'écran", "kind": "complaint",
     "patterns": ["\\bscreen reader\\b", "\\bvoice ?over\\b", "\\bvisually impaired\\b", "\\bblind\\b", "\\baccessib"]},
    {"id": "stats", "label": "Statistiques fausses ou absentes", "kind": "complaint",
     "patterns": ["\\banalytics\\b", "\\bstats\\b", "\\binsights?\\b", "\\bgraphs\\b", "\\bactivity data\\b"]},
    {"id": "language", "label": "Pas en français", "kind": "complaint",
     "patterns": ["\\bfran[cç]ais\\b", "\\bfrench\\b", "\\blangue\\b", "\\bchanger de langue\\b", "\\bnuméro français\\b"]},
    {"id": "look", "label": "Pages génériques, vieillottes ou trop marquées par l'outil", "kind": "complaint",
     "patterns": ["\\boutdated\\b", "\\bugly\\b", "\\bfonts?\\b", "\\bobnoxiously branded\\b", "\\bpersonal website\\b", "\\bfelt personal\\b", "\\bcookie.?cutter\\b", "\\bjust cards\\b", "\\bpresets\\b"]},
    {"id": "bugs", "label": "Bugs, plantages, éditeur qui ne répond pas", "kind": "complaint",
     "patterns": ["\\bcrash", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez", "\\bfrozen\\b", "\\bbroken\\b", "\\bnot working\\b", "\\b(doesn'?t|does not|didn'?t|won'?t) (work|open)\\b", "\\berror\\b", "\\bblank screen\\b", "\\bwhite screen\\b", "\\bbeug\\b", "\\bbug\\b"]},
    {"id": "slow", "label": "Lent", "kind": "complaint",
     "patterns": ["\\bslow\\b", "\\blag", "\\bloading\\b", "\\btakes? forever\\b", "\\btaking forever\\b", "\\bchargement infini\\b"]},
    {"id": "account", "label": "Connexion et création de compte", "kind": "complaint",
     "patterns": ["\\blog ?in\\b", "\\blogged out\\b", "\\bsign ?in\\b", "\\bsign ?up\\b", "\\bpassword\\b", "\\blocked out\\b", "\\bverification code\\b", "\\bcréer un compte\\b", "\\bse connecter\\b", "\\bconnexion\\b", "\\bcréation de compte\\b", "\\bmot de passe\\b", "\\bidentifiants\\b"]},
    {"id": "support", "label": "Support qui ne répond pas", "kind": "complaint",
     "patterns": ["\\bcustomer (service|support)\\b", "\\bno (answer|response|reply|live person|human)\\b", "\\bescalation\\b", "\\bticket\\b", "\\btechnical support\\b"]},
    {"id": "notifications", "label": "Pas prévenu (ventes, messages)", "kind": "request",
     "patterns": ["\\bnotifications?\\b", "\\balerts?\\b"]},
    {"id": "domain", "label": "Domaine personnel", "kind": "request",
     "patterns": ["\\bcustom domain\\b", "\\bown (custom )?domain\\b", "\\byour\\.domain\\b", "\\bmy domain\\b"]},
    {"id": "customisation", "label": "Personnalisation", "kind": "request",
     "patterns": ["\\bcustomi[sz]", "\\bdesign options\\b", "\\bgrid\\b", "\\btemplates?\\b", "\\blayouts?\\b", "\\bcolumns\\b", "\\bplus de liberté\\b"]},
    {"id": "simplicity", "label": "Trop d'options, je veux juste mes liens", "kind": "request",
     "patterns": ["\\bway more options than\\b", "\\bjust wanted (a|to)\\b", "\\bovercomplicat", "\\bshould be simple\\b", "\\bbloat\\b", "\\bno clutter\\b", "\\btoo focused on monetiz", "\\bnot interested in monetizing\\b", "\\bconvoluted\\b"]},
    {"id": "tips", "label": "Recevoir de l'argent directement (dons, pourboires)", "kind": "request",
     "patterns": ["\\breceive tips\\b", "\\btips? (go|goes|directly)\\b", "\\bvenmo\\b", "\\bcash app\\b", "\\bpatreon\\b", "\\bpay (them|authors) directly\\b", "\\bfaire un don\\b", "\\bdons\\b", "\\bdonations?\\b"]}
  ]
}
